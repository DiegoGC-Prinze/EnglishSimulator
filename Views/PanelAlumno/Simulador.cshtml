@{
    ViewData["Title"] = "Simulador - Examen";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

    <!-- Tu archivo global con las clases .btn-3d -->
    <link rel="stylesheet" href="~/css/site.css" />

    <style>
        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #f7f9fb;
            background-image: linear-gradient(#e5ecf3 1px, transparent 1px), linear-gradient(90deg, #e5ecf3 1px, transparent 1px);
            background-size: 24px 24px;
            color: #1a202c;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }

        /* --- CONTENEDOR PRINCIPAL DEL EXAMEN --- */
        .exam-container {
            background-color: #ffffff;
            border: 2px solid #cbd5e1;
            border-radius: 16px;
            width: 100%;
            max-width: 1000px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            padding: 2rem 2.5rem;
            position: relative;
        }

        /* --- HEADER DEL EXAMEN --- */
        .exam-header {
            background-color: #f1f5f9;
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            padding: 1rem 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
        }

        .exam-title {
            font-weight: 800;
            font-size: 1.25rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin: 0;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 1.5rem;
            font-weight: 600;
        }

        /* --- SECCIÓN DE PROGRESO Y TIEMPO --- */
        .progress-section {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
            font-weight: 600;
            font-size: 1.05rem;
        }

        /* Barra de progreso personalizada */
        .progress-wrapper {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .custom-progress-bar {
            width: 250px;
            height: 24px;
            background-color: #ffffff;
            border: 2px solid #cbd5e1;
            border-radius: 12px;
            overflow: hidden;
            position: relative;
        }

        .custom-progress-fill {
            height: 100%;
            background-color: #86efac; /* Verde pastel del boceto */
            width: 50%; /* Representa la mitad del examen (10 de 20) */
            transition: width 0.5s ease;
        }

        /* Cronómetro */
        .timer-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            margin-bottom: 1rem;
        }

        .timer-label {
            font-size: 0.85rem;
            font-weight: 700;
            letter-spacing: 1px;
            color: #475569;
            margin-bottom: 4px;
        }

        .timer-box {
            background-color: #fca5a5; /* Rojo/Rosa pastel */
            border: 2px solid #ef4444;
            color: #7f1d1d;
            font-weight: 800;
            font-size: 1.4rem;
            padding: 0.3rem 2rem;
            border-radius: 20px;
            box-shadow: 0 3px 0 #ef4444;
            letter-spacing: 2px;
        }
        /* Animación cuando quedan menos de 10 segundos */
        .timer-warning {
            background-color: #ef4444;
            color: white;
            animation: pulse 1s infinite;
        }

        @@keyframes pulse {
            0% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.05);
            }

            100% {
                transform: scale(1);
            }
        }

        /* Línea separadora gruesa */
        .separator {
            border: 0;
            height: 2px;
            background-color: #cbd5e1;
            margin: 1.5rem 0 2rem 0;
        }

        /* --- ÁREA DE PREGUNTA Y OPCIONES --- */
        .question-instruction {
            font-weight: 700;
            color: #64748b;
            text-transform: uppercase;
            font-size: 0.95rem;
            letter-spacing: 0.5px;
            margin-bottom: 0.5rem;
        }

        .question-text {
            font-weight: 800;
            font-size: 1.4rem;
            color: #1e293b;
            margin-bottom: 0.5rem;
        }

        .question-sentence {
            font-weight: 600;
            font-size: 1.3rem;
            color: #334155;
            margin-bottom: 1.5rem;
        }

        .options-title {
            font-weight: 700;
            font-size: 1.1rem;
            margin-bottom: 1rem;
            color: #475569;
        }

        /* Custom Radio Buttons grandes */
        .option-label {
            display: flex;
            align-items: center;
            font-size: 1.25rem;
            font-weight: 500;
            padding: 0.6rem 1rem;
            border-radius: 8px;
            cursor: pointer;
            transition: 0.2s;
            margin-bottom: 0.5rem;
        }

            .option-label:hover {
                background-color: #f1f5f9;
            }

        .form-check-input {
            width: 1.5em;
            height: 1.5em;
            margin-right: 1rem;
            cursor: pointer;
            border: 2px solid #94a3b8;
        }

            .form-check-input:checked {
                background-color: #0dcaf0;
                border-color: #0dcaf0;
            }

        .option-letter {
            font-weight: 800;
            margin-right: 0.5rem;
        }

        /* --- ÁREA DE IMAGEN DE APOYO --- */
        .image-placeholder {
            width: 100%;
            height: 220px;
            border: 2px dashed #94a3b8;
            border-radius: 12px;
            display: flex;
            justify-content: center;
            align-items: center;
            background-color: #f8fafc;
            color: #64748b;
            font-weight: 700;
            font-size: 1rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 2rem;
        }
    </style>
</head>
<body>

    <div class="exam-container">

        <!-- ENCABEZADO SUPERIOR -->
        <div class="exam-header">
            <h2 class="exam-title">TEST INGLES</h2>
            <div class="header-right">
                <span>Bienvenido, Aldair Lopez</span>
                <!-- Botón 3D rojo de tu CSS global -->
                <a href="/PanelAlumno/Index" class="btn-3d btn-3d-red px-3 py-1" style="font-size: 0.95rem;">
                    Salir de la prueba
                </a>
            </div>
        </div>

        <!-- BARRA DE PROGRESO Y DATOS -->
        <div class="progress-section">
            <div class="progress-wrapper">
                <span>Progreso:</span>
                <div class="custom-progress-bar">
                    <div class="custom-progress-fill"></div>
                </div>
            </div>
            <div>Pregunta 10 de 20</div>
            <div>Valor: 5 puntos</div>
        </div>

        <!-- CRONÓMETRO -->
        <div class="timer-container">
            <div class="timer-label">TIEMPO:</div>
            <div class="timer-box" id="time-display">
                01:00
            </div>
        </div>

        <hr class="separator" />

        <!-- ÁREA DEL EXAMEN A DOS COLUMNAS -->
        <div class="row">

            <!-- Columna Izquierda: Preguntas y Opciones -->
            <div class="col-md-7 pe-md-4">
                <div class="question-instruction">Select the correct answer:</div>
                <div class="question-text">"HOW OLD IS SHE?"</div>
                <div class="question-sentence">"SHE ______ 28 YEARS OLD."</div>

                <div class="options-title">OPTIONS:</div>

                <div class="options-container">
                    <label class="option-label">
                        <input class="form-check-input" type="radio" name="answer" value="has">
                        <span class="option-letter">A.</span> has
                    </label>
                    <label class="option-label">
                        <input class="form-check-input" type="radio" name="answer" value="is">
                        <span class="option-letter">B.</span> is
                    </label>
                    <label class="option-label">
                        <input class="form-check-input" type="radio" name="answer" value="are">
                        <span class="option-letter">C.</span> are
                    </label>
                    <label class="option-label">
                        <input class="form-check-input" type="radio" name="answer" value="have">
                        <span class="option-letter">D.</span> have
                    </label>
                </div>
            </div>

            <!-- Columna Derecha: Imagen y Botón Siguiente -->
            <div class="col-md-5 d-flex flex-column justify-content-between">
                <div>
                    <!-- Caja punteada para la imagen de apoyo visual -->
                    <div class="image-placeholder">
                        <i class="bi bi-image me-2 fs-4"></i> IMAGEN DE APOYO VISUAL
                    </div>
                </div>

                <div class="text-end">
                    <!-- Botón 3D verde de tu CSS global -->
                    <button class="btn-3d btn-3d-green px-4 py-2" id="btn-next" onclick="siguientePregunta()">
                        SIGUIENTE PREGUNTA <i class="bi bi-caret-right-fill ms-1"></i>
                    </button>
                </div>
            </div>

        </div>
    </div>

    <!-- ==============================================
         LÓGICA JAVASCRIPT DEL CRONÓMETRO
         ============================================== -->
    <script>
        // Iniciar en 60 segundos
        let timeLeft = 60;
        const timeDisplay = document.getElementById('time-display');

        const countdown = setInterval(() => {
            timeLeft--;

            // Formatear a dos dígitos (ej. 00:09)
            let seconds = timeLeft < 10 ? '0' + timeLeft : timeLeft;
            timeDisplay.innerText = '00:' + seconds;

            // Alerta visual cuando quedan 10 segundos o menos
            if (timeLeft <= 10 && timeLeft > 0) {
                timeDisplay.classList.add('timer-warning');
            }

            // Cuando el tiempo llega a cero
            if (timeLeft <= 0) {
                clearInterval(countdown);
                timeDisplay.innerText = '00:00';

                // Mostrar alerta y simular clic en siguiente pregunta
                alert('¡Se agotó el tiempo! Avanzando a la siguiente pregunta...');
                siguientePregunta();
            }
        }, 1000); // 1000 milisegundos = 1 segundo

        // Función que se ejecuta al darle Siguiente
        function siguientePregunta() {
            // Aquí en el futuro tu compañero de backend pondrá su código.
            // Por ahora, solo recargamos la página para simular que avanzó.
            window.location.reload();
        }
    </script>
</body>
</html>