@{
    ViewData["Title"] = "Simulador - Examen";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

    <!-- Tu archivo global con las clases .btn-3d -->
    <link rel="stylesheet" href="~/css/site.css" />

    <style>
        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #f7f9fb;
            background-image: linear-gradient(#e5ecf3 1px, transparent 1px), linear-gradient(90deg, #e5ecf3 1px, transparent 1px);
            background-size: 24px 24px;
            color: #1a202c;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }

        /* --- CONTENEDOR PRINCIPAL DEL EXAMEN --- */
        .exam-container {
            background-color: #ffffff;
            border: 2px solid #cbd5e1;
            border-radius: 16px;
            width: 100%;
            max-width: 1000px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            padding: 2rem 2.5rem;
            position: relative;
        }

        /* --- HEADER DEL EXAMEN --- */
        .exam-header {
            background-color: #f1f5f9;
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            padding: 1rem 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
        }

        .exam-title {
            font-weight: 800;
            font-size: 1.25rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin: 0;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 1.5rem;
            font-weight: 600;
        }

        /* --- SECCIÓN DE PROGRESO Y TIEMPO --- */
        .progress-section {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
            font-weight: 600;
            font-size: 1.05rem;
        }

        /* Barra de progreso personalizada */
        .progress-wrapper {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .custom-progress-bar {
            width: 250px;
            height: 24px;
            background-color: #ffffff;
            border: 2px solid #cbd5e1;
            border-radius: 12px;
            overflow: hidden;
            position: relative;
        }

        .custom-progress-fill {
            height: 100%;
            background-color: #86efac; /* Verde pastel del boceto */
            width: 50%; /* Representa la mitad del examen (10 de 20) */
            transition: width 0.5s ease;
        }

        /* Cronómetro */
        .timer-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            margin-bottom: 1rem;
        }

        .timer-label {
            font-size: 0.85rem;
            font-weight: 700;
            letter-spacing: 1px;
            color: #475569;
            margin-bottom: 4px;
        }

        .timer-box {
            background-color: #fca5a5; /* Rojo/Rosa pastel */
            border: 2px solid #ef4444;
            color: #7f1d1d;
            font-weight: 800;
            font-size: 1.4rem;
            padding: 0.3rem 2rem;
            border-radius: 20px;
            box-shadow: 0 3px 0 #ef4444;
            letter-spacing: 2px;
        }
        /* Animación cuando quedan menos de 10 segundos */
        .timer-warning {
            background-color: #ef4444;
            color: white;
            animation: pulse 1s infinite;
        }

        @@keyframes pulse {
            0% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.05);
            }

            100% {
                transform: scale(1);
            }
        }

        /* Línea separadora gruesa */
        .separator {
            border: 0;
            height: 2px;
            background-color: #cbd5e1;
            margin: 1.5rem 0 2rem 0;
        }

        /* --- ÁREA DE PREGUNTA Y OPCIONES --- */
        .question-instruction {
            font-weight: 700;
            color: #64748b;
            text-transform: uppercase;
            font-size: 0.95rem;
            letter-spacing: 0.5px;
            margin-bottom: 0.5rem;
        }

        .question-text {
            font-weight: 800;
            font-size: 1.4rem;
            color: #1e293b;
            margin-bottom: 0.5rem;
        }

        .question-sentence {
            font-weight: 600;
            font-size: 1.3rem;
            color: #334155;
            margin-bottom: 1.5rem;
        }

        .options-title {
            font-weight: 700;
            font-size: 1.1rem;
            margin-bottom: 1rem;
            color: #475569;
        }

        /* Custom Radio Buttons grandes */
        .option-label {
            display: flex;
            align-items: center;
            font-size: 1.25rem;
            font-weight: 500;
            padding: 0.6rem 1rem;
            border-radius: 8px;
            cursor: pointer;
            transition: 0.2s;
            margin-bottom: 0.5rem;
        }

            .option-label:hover {
                background-color: #f1f5f9;
            }

        .form-check-input {
            width: 1.5em;
            height: 1.5em;
            margin-right: 1rem;
            cursor: pointer;
            border: 2px solid #94a3b8;
        }

            .form-check-input:checked {
                background-color: #0dcaf0;
                border-color: #0dcaf0;
            }

        .option-letter {
            font-weight: 800;
            margin-right: 0.5rem;
        }

        /* --- ÁREA DE IMAGEN DE APOYO --- */
        .image-placeholder {
            width: 100%;
            height: 220px;
            border: 2px dashed #94a3b8;
            border-radius: 12px;
            display: flex;
            justify-content: center;
            align-items: center;
            background-color: #f8fafc;
            color: #64748b;
            font-weight: 700;
            font-size: 1rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 2rem;
        }
    </style>
</head>
<body>

    <div class="exam-container">

        <!-- ENCABEZADO SUPERIOR -->
        <div class="exam-header">
            <h2 class="exam-title">TEST INGLES</h2>
            <div class="header-right">
                <span>Bienvenido, @User.Identity?.Name</span>
                <a href="/PanelAlumno/Index" class="btn-3d btn-3d-red px-3 py-1" style="font-size: 0.95rem;">
                    Salir de la prueba
                </a>
            </div>
        </div>

        <!-- BARRA DE PROGRESO Y DATOS -->
        <div class="progress-section">
            <div class="progress-wrapper">
                <span>Progreso:</span>
                <div class="custom-progress-bar">
                    <!-- Agregamos id="progressBar" -->
                    <div class="custom-progress-fill" id="progressBar" style="width: 0%;"></div>
                </div>
            </div>
            <!-- Agregamos id="progressText" y id="questionValue" -->
            <div id="progressText">Cargando...</div>
            <div id="questionValue">Valor: -- puntos</div>
        </div>

        <!-- CRONÓMETRO -->
        <div class="timer-container">
            <div class="timer-label">TIEMPO:</div>
            <div class="timer-box" id="time-display">
                01:00
            </div>
        </div>

        <hr class="separator" />

        <!-- ÁREA DEL EXAMEN A DOS COLUMNAS -->
        <div class="row">

            <!-- Columna Izquierda: Preguntas y Opciones -->
            <div class="col-md-7 pe-md-4">
                <div class="question-instruction">Select the correct answer:</div>
                <!-- Agregamos IDs para inyectar el texto dinámico -->
                <div class="question-text" id="qText">Cargando pregunta...</div>
                <div class="question-sentence" id="qSentence"></div>

                <div class="options-title">OPTIONS:</div>
                <!-- Vaciamos el contenedor y le ponemos ID para inyectar los radio buttons -->
                <div class="options-container" id="optionsContainer">
                    <!-- JS inyectará las opciones aquí -->
                </div>
            </div>

            <!-- Columna Derecha: Imagen y Botón Siguiente -->
            <div class="col-md-5 d-flex flex-column justify-content-between">
                <div>
                    <!-- Agregamos id="qImageContainer" -->
                    <div class="image-placeholder" id="qImageContainer" style="display: none;">
                        <i class="bi bi-image me-2 fs-4"></i> IMAGEN DE APOYO VISUAL
                    </div>
                </div>
                <div class="text-end">
                    <button type="button" class="btn-3d btn-3d-green px-4 py-2" id="btn-next">
                        SIGUIENTE PREGUNTA <i class="bi bi-caret-right-fill ms-1"></i>
                    </button>
                </div>
            </div>

        </div>
    </div>

    <!-- ==============================================
     LÓGICA JAVASCRIPT DEL SIMULADOR (ULTRA-SINCRONIZADA)
     ============================================== -->
    <script>
        let timeLeft = 60;
        let countdown;
        let heartbeatInterval;
        let currentQuestionId = 0;
        let currentAttemptId = 0;

        // 1. Obtener el gafete de seguridad
        async function obtenerGafete() {
            try {
                const res = await fetch('/api/auth/csrf');
                const data = await res.json();
                return data.token;
            } catch (e) {
                console.error("Error obteniendo token:", e);
                return "";
            }
        }

        // 2. Iniciar el examen
        async function iniciarExamen() {
            const params = new URLSearchParams(window.location.search);
            const examType = params.get('tipo') || 'practice';
            const token = await obtenerGafete();

            try {
                const response = await fetch('/api/exams/start', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': token },
                    body: JSON.stringify({ ExamType: examType })
                });

                if (response.ok) {
                    const data = await response.json();
                    currentAttemptId = data.attemptId || data.id;
                    obtenerPregunta();
                } else {
                    alert("Fallo al iniciar el examen.");
                }
            } catch (error) {
                console.error("Error iniciando examen:", error);
            }
        }

        // 3. Obtener la pregunta (Llama a /resume)
        async function obtenerPregunta() {
            try {
                const token = await obtenerGafete();
                const response = await fetch(`/api/exams/${currentAttemptId}/resume`, {
                    method: 'POST',
                    headers: { 'X-CSRF-TOKEN': token }
                });

                if (response.ok) {
                    const data = await response.json();

                    if (data.status !== "EN_PROCESO") {
        window.location.href = `/PanelAlumno/Resultados?id=${currentAttemptId}`;
        return;
                    }
                    renderizarPregunta(data);
                }
            } catch (error) {
                console.error("Error obteniendo pregunta:", error);
            }
        }

        // 4. Inyectar datos en HTML
        function renderizarPregunta(data) {
            const pregunta = data.currentQuestion;
            currentQuestionId = pregunta.id;

            document.getElementById('qText').innerText = pregunta.text || "";
            document.getElementById('qSentence').innerText = "";

            const currentPosition = data.currentPosition || 1;
            const totalQuestions = data.totalQuestions || 20;

            const puntos = totalQuestions === 40 ? 2.5 : 5;
            document.getElementById('questionValue').innerText = `Valor: ${puntos} puntos`;

            document.getElementById('progressText').innerText = `Pregunta ${currentPosition} de ${totalQuestions}`;

            const porcentaje = (currentPosition / totalQuestions) * 100;
            document.getElementById('progressBar').style.width = `${porcentaje}%`;

            const optionsContainer = document.getElementById('optionsContainer');
            optionsContainer.innerHTML = '';
            const letras = ['A', 'B', 'C', 'D', 'E', 'F'];

            const opcionesArray = pregunta.options || [];
            opcionesArray.forEach((opcion, index) => {
                const html = `
                    <label class="option-label">
                        <input class="form-check-input" type="radio" name="answer" value="${opcion.id}">
                        <span class="option-letter">${letras[index]}.</span> ${opcion.text}
                    </label>
                `;
                optionsContainer.insertAdjacentHTML('beforeend', html);
            });

            // Aseguramos habilitar el botón
            document.getElementById('btn-next').disabled = false;
            iniciarCronometro(data.secondsRemaining || 60);
        }

        // NUEVO: Latido Inteligente que alinea tu reloj con el de C#
        async function enviarLatido() {
            try {
                const token = await obtenerGafete();
                const response = await fetch(`/api/exams/${currentAttemptId}/heartbeat`, {
                    method: 'POST',
                    headers: { 'X-CSRF-TOKEN': token }
                });

                if (response.ok) {
                    const data = await response.json();
                    // Si hay mucha desincronización por culpa del internet, ajustamos el reloj silenciosamente
                    if (data.status === "EN_PROCESO" && data.currentQuestion && data.currentQuestion.id === currentQuestionId) {
                        if (Math.abs(timeLeft - data.secondsRemaining) > 2) {
                            timeLeft = data.secondsRemaining;
                        }
                    }
                }
            } catch(e) {}
        }

        // NUEVO: Validar si de verdad C# llegó a cero
        async function verificarTiempoAgotado() {
            try {
                const token = await obtenerGafete();
                const response = await fetch(`/api/exams/${currentAttemptId}/heartbeat`, {
                    method: 'POST',
                    headers: { 'X-CSRF-TOKEN': token }
                });

                if (response.ok) {
                    const data = await response.json();

                    // Si C# dice que todavía faltan esos famosos 3 segundos
                    if (data.status === "EN_PROCESO" && data.currentQuestion && data.currentQuestion.id === currentQuestionId && data.secondsRemaining > 0) {
                        document.getElementById('btn-next').disabled = false;
                        iniciarCronometro(data.secondsRemaining); // Reanuda los 3 segundos faltantes
                        return;
                    }

                    // Si C# confirma que ya hizo el cambio de pregunta
                    alert("¡Se agotó el tiempo! Avanzando a la siguiente...");
                    obtenerPregunta(); // Llama a /resume
                }
            } catch(e) {
                console.error(e);
            }
        }

        // 5. Cronómetro
        function iniciarCronometro(segundos) {
            clearInterval(countdown);
            clearInterval(heartbeatInterval);

            timeLeft = segundos;
            const timeDisplay = document.getElementById('time-display');
            timeDisplay.classList.remove('timer-warning');

            heartbeatInterval = setInterval(() => {
                enviarLatido();
            }, 5000);

            countdown = setInterval(() => {
                timeLeft--;
                let secText = timeLeft < 10 ? '0' + timeLeft : timeLeft;
                timeDisplay.innerText = '00:' + secText;

                if (timeLeft <= 10 && timeLeft > 0) {
                    timeDisplay.classList.add('timer-warning');
                }

                if (timeLeft <= 0) {
                    // Frenamos todo
                    clearInterval(countdown);
                    clearInterval(heartbeatInterval);
                    timeDisplay.innerText = '00:00';
                    document.getElementById('btn-next').disabled = true;

                    // Le preguntamos a C# si de verdad ya se acabó
                    verificarTiempoAgotado();
                }
            }, 1000);
        }

        // 6. Enviar Respuesta Manual
        async function enviarRespuesta() {
            const btnNext = document.getElementById('btn-next');
            btnNext.disabled = true;

            const seleccion = document.querySelector('input[name="answer"]:checked');
            if (!seleccion) {
                alert("Por favor selecciona una opción.");
                btnNext.disabled = false;
                return;
            }

            clearInterval(countdown);
            clearInterval(heartbeatInterval);

            const respuestaId = parseInt(seleccion.value);
            const token = await obtenerGafete();

            try {
                const response = await fetch(`/api/exams/${currentAttemptId}/answer`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': token
                    },
                    body: JSON.stringify({
                        questionId: currentQuestionId,
                        optionId: respuestaId
                    })
                });

                if (response.ok) {
                    obtenerPregunta(); // Avanza rápido sin alertas
                } else {
                    alert("Error al enviar la respuesta.");
                    btnNext.disabled = false;
                    iniciarCronometro(timeLeft); // Reanuda si falló la red
                }
            } catch (error) {
                console.error(error);
                btnNext.disabled = false;
                iniciarCronometro(timeLeft);
            }
        }

        // 7. Eventos
        document.addEventListener("DOMContentLoaded", () => {
            const btnNext = document.getElementById('btn-next');
            if (btnNext) {
                btnNext.addEventListener('click', function(e) {
                    e.preventDefault();
                    enviarRespuesta();
                });
            }
            iniciarExamen();
        });
    </script>
</body>
</html>