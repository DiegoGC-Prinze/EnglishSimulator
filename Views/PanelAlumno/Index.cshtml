@{
    ViewData["Title"] = "Inicio - Panel del Alumno";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Tipografía Montserrat -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" />

    <style>
        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #f7f9fb;
            background-image: linear-gradient(#e5ecf3 1px, transparent 1px), linear-gradient(90deg, #e5ecf3 1px, transparent 1px);
            background-size: 24px 24px;
            color: #1a202c;
            margin: 0;
            height: 100vh;
            display: flex;
            flex-direction: column;
        }
        /* --- NAVBAR SUPERIOR --- */
        .top-navbar {
            background-color: #fdfdfd;
            border-bottom: 2px solid #e2e8f0;
            padding: 0.8rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 10;
        }

        .navbar-brand-title {
            font-weight: 800;
            font-size: 1.4rem;
            letter-spacing: -0.5px;
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 1.5rem;
            font-weight: 500;
        }

        .btn-logout {
            background-color: #fca5a5; /* Rojo pastel */
            color: #7f1d1d;
            border: none;
            border-radius: 6px;
            padding: 0.4rem 1rem;
            font-weight: 600;
            text-decoration: none;
            transition: 0.2s;
        }

            .btn-logout:hover {
                background-color: #ef4444;
                color: white;
            }


        /* --- CONTENEDOR PRINCIPAL --- */
        .main-wrapper {
            display: flex;
            flex: 1;
            overflow: hidden;
        }


        /* --- SIDEBAR --- */
        .sidebar {
            width: 260px;
            background-color: #fdfdfd;
            border-right: 2px solid #e2e8f0;
            padding: 1.5rem 1rem;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .menu-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.8rem 1rem;
            border-radius: 8px;
            color: #4a5568;
            text-decoration: none;
            font-weight: 500;
            transition: 0.2s;
        }

            .menu-item:hover {
                background-color: #f1f5f9;
                color: #1a202c;
            }

            .menu-item.active {
                background-color: #e2e8f0;
                color: #1a202c;
                font-weight: 700;
                border-left: 4px solid #64748b;
            }

        .menu-icon {
            font-size: 1.1rem;
        }


        /* --- ÁREA DE CONTENIDO --- */
        .content-area {
            flex: 1;
            padding: 2rem 3rem;
            overflow-y: auto;
        }

        /* Títulos */
        .page-title {
            font-weight: 800;
            font-size: 2.2rem;
            text-align: center;
            margin-bottom: 0.2rem;
            color: #1a202c;
        }

        .page-subtitle {
            font-weight: 500;
            font-size: 1.3rem;
            text-align: center;
            margin-bottom: 1.5rem;
            color: #2d3748;
        }

        /* Alerta Recordatorio */
        .alert-strict {
            background-color: transparent;
            color: #a13232; /* Rojo oscuro del boceto */
            font-weight: 600;
            font-size: 0.9rem;
            display: flex;
            align-items: flex-start;
            gap: 0.5rem;
            max-width: 800px;
            margin: 0 auto 2.5rem auto;
            text-align: justify;
        }

            .alert-strict i {
                font-size: 1.3rem;
                margin-top: -2px;
            }

        /* --- TARJETAS DE PRUEBAS --- */
        .cards-container {
            display: flex;
            justify-content: center;
            gap: 2rem;
            flex-wrap: wrap;
        }

        .test-card {
            background-color: #ffffff;
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            width: 340px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0,0,0,0.02);
            display: flex;
            flex-direction: column;
        }

        .test-header {
            background-color: #e2e8f0;
            padding: 1.2rem;
            text-align: center;
            font-weight: 700;
            font-size: 1.3rem;
            color: #1a202c;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
        }

        .test-body {
            padding: 1.5rem;
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .test-list {
            list-style: none;
            padding: 0;
            margin: 0 0 1.5rem 0;
            font-size: 0.9rem;
            font-weight: 500;
            color: #2d3748;
        }

            .test-list li {
                margin-bottom: 0.8rem;
                display: flex;
                align-items: flex-start;
                gap: 0.5rem;
            }

            .test-list i {
                color: #4a5568;
                font-size: 1.1rem;
            }

        .intentos-text {
            text-align: center;
            font-weight: 600;
            font-size: 1.1rem;
            color: #4a5568;
            margin-bottom: 1rem;
            margin-top: auto;
        }

        .intentos-highlight {
            color: #d97706;
        }
        /* Color naranja para los números */

        .btn-iniciar {
            background-color: #86efac; /* Verde pastel del botón */
            color: #166534;
            border: none;
            border-radius: 6px;
            padding: 0.7rem;
            font-weight: 700;
            font-size: 1rem;
            width: 100%;
            transition: 0.2s;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
        }

            .btn-iniciar:hover {
                background-color: #6ee7b7;
                transform: translateY(-2px);
            }
    </style>
</head>
<body>

    <!-- NAVBAR SUPERIOR -->
    <nav class="top-navbar">
        <div class="navbar-brand-title">TEST INGLES</div>
        <div class="user-info">
            <span>Bienvenido, @User.Identity?.Name <i class="bi bi-person ms-1 fs-5"></i></span>
            <a href="/Acceso/Index" class="btn-3d btn-3d-red px-3 py-1" style="font-size: 0.9rem;">
                Cerrar Sesion <i class="bi bi-box-arrow-right ms-1"></i>
            </a>
        </div>
    </nav>

    <!-- CONTENEDOR PRINCIPAL -->
    <div class="main-wrapper">

        <!-- BARRA LATERAL -->
        <aside class="sidebar">
            <a href="/PanelAlumno/Index" class="menu-item active">
                <span>-- Inicio</span>
            </a>
            <a href="/PanelAlumno/SimuladorPractica" class="menu-item">
                <span>-- Simulador de practica</span>
                <i class="bi bi-gear menu-icon"></i>
            </a>
            <a href="/PanelAlumno/PruebaFinal" class="menu-item">
                <span>-- Prueba final</span>
                <i class="bi bi-file-earmark-check menu-icon"></i>
            </a>
            <a href="/PanelAlumno/Historial" class="menu-item">
                <span>-- Historial</span>
                <i class="bi bi-clock-history menu-icon"></i>
            </a>
        </aside>

        <!-- ÁREA DE CONTENIDO -->
        <main class="content-area">

            <h1 class="page-title">INICIO</h1>
            <h2 class="page-subtitle">Selecciona tu prueba</h2>

            <div class="alert-strict">
                <i class="bi bi-stopwatch"></i>
                <span>RECORDATORIO: Tienes un tiempo estricto de 1 minuto por pregunta. En caso de agotar el tiempo, el sistema avanzara a la siguiente pregunta y la pregunta anterior se toma como incorrecta.</span>
            </div>

            <!-- TARJETAS -->
            <div class="cards-container">

                <!-- Tarjeta 1: Práctica -->
                <div class="test-card">
                    <div class="test-header">
                        Simulador de<br>practica
                    </div>
                    <div class="test-body">
                        <ul class="test-list">
                            <li><i class="bi bi-journal-text"></i> 20 Preguntas aleatorias</li>
                            <li><i class="bi bi-diagram-3"></i> Valor de 5 puntos por reactivo</li>
                            <li><i class="bi bi-percent"></i> Puntaje mínimo aprobatorio:<br>70%</li>
                        </ul>
                        <div class="intentos-text">
                            Intentos: <span class="intentos-highlight" id="intentosPractica">Cargando...</span>
                        </div>
                        <a asp-controller="PanelAlumno" asp-action="SimuladorPractica" class="btn-3d btn-3d-green w-100 py-2 text-decoration-none">
                            INICIAR <i class="bi bi-chevron-right ms-1"></i>
                        </a>
                    </div>
                </div>

                <!-- Tarjeta 2: Prueba Final -->
                <div class="test-card">
                    <div class="test-header">
                        Prueba final <i class="bi bi-award fs-4"></i>
                    </div>
                    <div class="test-body">
                        <ul class="test-list">
                            <li><i class="bi bi-journal-text"></i> 40 Preguntas aleatorias</li>
                            <li><i class="bi bi-diagram-3"></i> Valor de 2,5 puntos por reactivo</li>
                            <li><i class="bi bi-percent"></i> Puntaje mínimo aprobatorio:<br>70%</li>
                            <li><i class="bi bi-bar-chart-steps"></i> Determina tu nivel: Basico,<br>Intermedio o Avanzado</li>
                        </ul>
                        <div class="intentos-text">
                            Intentos: <span class="intentos-highlight" id="intentosFinal">Cargando...</span>
                        </div>
                        <a asp-controller="PanelAlumno" asp-action="PruebaFinal" class="btn-3d btn-3d-green w-100 py-2 text-decoration-none">
                            INICIAR <i class="bi bi-chevron-right ms-1"></i>
                        </a>
                    </div>
                </div>

            </div>
        </main>

    </div>
    <script>
        document.addEventListener("DOMContentLoaded", async () => {
            try {
                // Llamamos a la API de tu compañero que devuelve las estadísticas del alumno
                const response = await fetch('/api/results/summary');

                if (response.ok) {
                    const data = await response.json();

                    // La API devuelve un arreglo llamado "statistics"
                    // Asumimos que la Práctica es el primer tipo de examen y la Final el segundo
                    const statPractica = data.statistics[0];
                    const statFinal = data.statistics[1];

                    // Inyectamos los datos en tu diseño (Intentos Usados / Intentos Máximos)
                    if (statPractica) {
                        document.getElementById('intentosPractica').innerText =
                            `${statPractica.attemptsUsed} / ${statPractica.maxAttempts}`;
                    }

                    if (statFinal) {
                        document.getElementById('intentosFinal').innerText =
                            `${statFinal.attemptsUsed} / ${statFinal.maxAttempts}`;
                    }
                } else {
                    // Si la sesión expiró, redirigimos al login
                    if (response.status === 401) {
                        window.location.href = '/Acceso/Index';
                    }
                }
            } catch (error) {
                console.error("Error al cargar las estadísticas:", error);
                document.getElementById('intentosPractica').innerText = "? / 5";
                document.getElementById('intentosFinal').innerText = "? / 2";
            }
        });
    </script>
</body>
</html>